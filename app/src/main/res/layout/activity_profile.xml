<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Home Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="0dp"
            android:background="@drawable/back_texture" />

        <!-- Profile Title -->
        <TextView
            android:id="@+id/profileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/pixellari"
            android:gravity="center"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="60dp"
            android:textStyle="bold" />


        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/profilePicture"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile"
            android:background="@drawable/circle_background"
            android:layout_marginBottom="7dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/changeProfilePictureButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Picture"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:elevation="10dp"
            android:fontFamily="@font/pixellari"
            android:background="@drawable/custom_background"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <!-- Email and Nickname -->
        <TextView
            android:id="@+id/emailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixellari"
            android:layout_gravity="center"
            android:text="Email: "
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:layout_margin="16dp" />

        <TextView
            android:id="@+id/nicknameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nickname: "
            android:layout_gravity=""
            android:fontFamily="@font/pixellari"
            android:textColor="@color/background"
            android:textSize="24sp"
            android:layout_marginBottom="8dp" />

        <!-- Nickname Input -->
        <EditText
            android:id="@+id/nicknameInput"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixellari"
            android:hint="Enter new nickname"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/saveNicknameButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Nickname"
            android:layout_gravity="center"
            android:background="@drawable/custom_background"
            android:fontFamily="@font/pixellari"
            android:textColor="#FFFFFF"
            android:textSize="16dp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Stats and Achievements Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/statsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Statistics"
                android:fontFamily="@font/pixellari"
                android:background="@drawable/custom_background_stats"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:textSize="16dp"
                android:padding="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/viewAchievementsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Achievements"
                android:fontFamily="@font/pixellari"
                android:textSize="16dp"
                android:background="@drawable/custom_background_stats"
                android:textColor="#FFFFFF"
                android:padding="12dp" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="25dp" >

        </Space>
        <!-- Friends List Section -->
        <TextView
            android:id="@+id/friendsListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixellari"
            android:text="Friends List"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/friendsRecyclerView"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:background="#EAEDF0"
            android:padding="8dp" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="45dp" >
        </Space>

        <ProgressBar
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <!-- Add Friend Section -->
        <TextView
            android:id="@+id/addFriendLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixellari"
            android:text="Add a Friend"
            android:textSize="24sp"
            android:layout_marginVertical="16dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/addFriendInput"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixellari"
            android:hint="Enter friend's email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp" />

        <!-- Send and View Friend Requests Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sendFriendRequestButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Friend Request"
                android:fontFamily="@font/pixellari"
                android:background="@drawable/custom_background"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp"
                android:padding="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/viewFriendRequestsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Friend Requests"
                android:fontFamily="@font/pixellari"
                android:background="@drawable/custom_background_other"
                android:textColor="#FFFFFF"
                android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
