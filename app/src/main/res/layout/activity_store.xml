<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#35524A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/storeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Store"
            android:fontFamily="@font/pixellari"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Points Display -->
        <TextView
            android:id="@+id/pointsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Points: 0"
            android:fontFamily="@font/pixellari"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Hint Item -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#627C85"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Item Description -->
            <TextView
                android:id="@+id/itemDescriptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hint: Places a flag over a bomb"
                android:fontFamily="@font/pixellari"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <!-- Purchase Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buyHintButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#32DE8A"
                android:text="Buy (2000)"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/pixellari"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
