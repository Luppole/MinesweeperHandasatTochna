<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" /> <!-- Gray for disabled -->
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="#9E9E9E" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#457569"
                android:endColor="#133C32"
                android:angle="270" /> <!-- Gradient for default -->
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="#12211C" />
        </shape>
    </item>
</selector>




