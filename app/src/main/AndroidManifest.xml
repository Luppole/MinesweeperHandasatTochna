<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_texture"
        android:label="@string/Minesweeper"
        android:roundIcon="@drawable/logo_texture"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">
        <service android:name=".MusicService"
            android:exported="false" />

        <!-- Set SplashActivity as Launcher -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MinesweeperHansasatTochna"
            android:screenOrientation="sensor"> <!-- Allows both portrait and landscape -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Other activities -->
        <activity android:name=".LoginActivity" android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true" />
        <activity android:name=".GameActivity" android:screenOrientation="landscape" />
        <activity android:name=".FriendRequestsActivity" />
        <activity android:name=".SignupActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".LeaderboardActivity" />
        <activity android:name=".GameHistoryActivity" />
        <activity android:name=".StoreActivity" />
        <activity android:name=".StatsActivity" />
        <activity android:name=".RulesActivity" />
        <activity android:name=".LoadingActivity" android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity android:name=".AchievementsActivity" />
        <activity android:name=".SettingsActivity" />

        <!-- Register Notification Reminder Service -->
        <receiver android:name=".ReminderBroadcastReceiver" />
    </application>
</manifest>
