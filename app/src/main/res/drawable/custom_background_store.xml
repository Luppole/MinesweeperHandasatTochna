<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5E24B8" /> <!-- Darker purple when pressed -->
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="#4D1573" />
        </shape>
    </item>

    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#BDBDBD" /> <!-- Gray for disabled -->
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="#9E9E9E" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#9A48F6"
                android:endColor="#732EE4"
                android:angle="270" /> <!-- Gradient for default -->
            <corners android:radius="4dp" />
            <stroke android:width="2dp" android:color="#5E24B8" />
        </shape>
    </item>
</selector>
